# Copy to .env.local (never committed) and fill in from your Apple Developer account:
# Certificates, Identifiers & Profiles → Keys → a key with MapKit JS enabled.
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
# Contents of the .p8 file, on one line with \n between lines
MAPKIT_PRIVATE_KEY=
# Optional: lock tokens to the hosted site
MAPKIT_ORIGIN=
